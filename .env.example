DB_HOST=postgres
DB_PORT=5432
DB_NAME=loginsight
DB_USERNAME=loginsight
DB_PASSWORD=change-me

APP_CORS_ALLOWED_ORIGINS=http://localhost:3000
APP_LOG_ANALYSIS_MAX_FILE_SIZE=10MB

ANALYSIS_EXECUTOR_CORE_POOL_SIZE=2
ANALYSIS_EXECUTOR_MAX_POOL_SIZE=4
ANALYSIS_EXECUTOR_QUEUE_CAPACITY=50
ANALYSIS_EXECUTOR_THREAD_NAME_PREFIX=log-analysis-
ANALYSIS_JOB_MAX_RETRY=3
ANALYSIS_JOB_PROGRESS_INTERVAL=100
ANALYSIS_TEMP_DIRECTORY=/tmp/log-insight